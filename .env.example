# Variables de entorno. Copia este archivo a ".env" para desarrollo local,
# o configúralas en el panel de la plataforma (Render) para producción.

# Contraseña compartida del equipo (OBLIGATORIA en producción).
APP_PASSWORD=cambia-esta-contraseña

# Secreto para firmar las sesiones (OBLIGATORIO en producción).
# Usa una cadena larga y aleatoria, p. ej. el resultado de:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=pon-aqui-una-cadena-larga-aleatoria

# Cadena de conexión a Postgres (Neon/Supabase). Si NO está definida,
# la app usa SQLite local (server/data/compras.db) para desarrollo.
# DATABASE_URL=postgres://usuario:clave@host/basededatos?sslmode=require

# Marca el entorno como producción (Render la define sola, pero por si acaso).
# NODE_ENV=production

# Puerto (la plataforma suele inyectarlo automáticamente).
# PORT=3001

# (Opcional) Aviso por Microsoft Teams al crear una solicitud.
# URL del flujo de Power Automate ("Workflows"). Ver NOTIFICACIONES-TEAMS.md.
# TEAMS_WEBHOOK_URL=https://prod-XX.westus.logic.azure.com:443/workflows/....
